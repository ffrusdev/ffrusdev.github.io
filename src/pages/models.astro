---
// CH03: the Xephos: Starbound showcase. This channel gets its own "signal":
// a retro-future sci-fi title card (cream paper, heavy display type, one red
// word) over a muted, dystopian PS2 finish (dither, low-res viewers, grime,
// greys). Red is reserved for the XEPHOS title so it's the one loud thing. The rest of the site stays green CRT.
//
// Page order: title card → the film on a big-screen TV → the 3D models.
import Base from '../layouts/Base.astro';
import { film, specimens } from '../data/models';

const youtubeId = film.video.match(/(?:v=|youtu\.be\/|shorts\/|embed\/)([\w-]{11})/)?.[1];
const pad = (n: number) => String(n).padStart(2, '0');
const firstModelNum = youtubeId ? 2 : 1; // the film is section 01 when it's there
---

<Base
  title="3D Models"
  channel={3}
  description="Xephos: Starbound, a short 3D animated film by Nabil Luqman (frus), and its 3D models viewable in the browser with a PS2 filter."
>
  <Fragment slot="head">
    <!-- Dela Gothic One: a heavy, slightly quirky display face for the big titles. -->
    <link href="https://fonts.googleapis.com/css2?family=Dela+Gothic+One&display=swap" rel="stylesheet" />
  </Fragment>

  <div class="screen-page xph">
    <p class="xph-crumb">CH03 // SPECIMEN VIEWER</p>

    <!-- ===== title card ===== -->
    <header class="xph-hero">
      <div class="xph-hero-inner">
        <p class="xph-file">FILE № 03 &nbsp;/&nbsp; {film.kind.toUpperCase()}</p>
        <h1 class="xph-title">
          <span class="xph-title-main">{film.title}</span>
          <span class="xph-title-sub">: {film.subtitle}</span>
        </h1>
        <p class="xph-summary">{film.summary}</p>
        <dl class="xph-meta">
          <div><dt>CONTEXT</dt><dd>{film.context}</dd></div>
          <div><dt>CREDIT</dt><dd>{film.credit}</dd></div>
          <div><dt>TOOLS</dt><dd>{film.tools.join(' · ')}</dd></div>
        </dl>
        <div class="xph-hero-foot" aria-hidden="true">
          <span class="xph-barcode"></span>
          <span>XPH-STB / {pad(specimens.length)} SPECIMENS ON FILE</span>
        </div>
      </div>
      <span class="xph-stamp" aria-hidden="true">SOLO<br />PROD.</span>
    </header>

    <!-- ===== the film, on a big-screen TV ===== -->
    {youtubeId && (
      <section class="xph-spec" aria-labelledby="film-title">
        <header class="xph-spec-head">
          <span class="xph-num" aria-hidden="true">01</span>
          <div>
            <h2 id="film-title">THE FILM</h2>
            <p class="xph-role">NOW SHOWING · {film.title}: {film.subtitle}</p>
          </div>
        </header>

        <div class="xph-tv">
          <div class="xph-tv-screen">
            {/* youtube-nocookie = no tracking cookies until the visitor presses play */}
            <iframe
              src={`https://www.youtube-nocookie.com/embed/${youtubeId}`}
              title={`${film.title}: ${film.subtitle} (short film)`}
              loading="lazy"
              allow="accelerometer; encrypted-media; gyroscope; picture-in-picture; fullscreen"
              allowfullscreen
            ></iframe>
            {/* glass: scanlines + vignette + glare. pointer-events: none lets clicks reach the video */}
            <span class="xph-tv-glass" aria-hidden="true"></span>
          </div>
          <div class="xph-tv-panel" aria-hidden="true">
            <span class="xph-tv-brand">XPH<b>·</b>VISION</span>
            <span class="xph-tv-grille"></span>
            <span class="xph-tv-knobs"><i></i><i></i><em></em></span>
          </div>
        </div>
        <div class="xph-tv-feet" aria-hidden="true"><i></i><i></i></div>
      </section>
    )}

    <!-- ===== one section per model, stacked ===== -->
    {specimens.map((s, i) => (
      <section class="xph-spec" data-viewer data-file={s.file ?? ''} data-frame={s.frame ?? 3} aria-labelledby={`spec-${i}`}>
        <header class="xph-spec-head">
          <span class="xph-num" aria-hidden="true">{pad(firstModelNum + i)}</span>
          <div>
            <h2 id={`spec-${i}`}>{s.name}</h2>
            <p class="xph-role">{s.code} · {s.role}</p>
          </div>
        </header>

        <div class="xph-spec-body">
          <div class="xph-viewer">
            <div class="stage xph-stage" data-stage data-no-channel-keys>
              <span class="xph-frame" aria-hidden="true"></span>
              <span class="rec" aria-live="polite"><b>●</b> REC {s.code}</span>
              <button type="button" class="btn insert" data-insert>▶ INSERT TAPE (load 3D)</button>
              <span class="hint">drag: rotate · scroll: zoom</span>
            </div>
            <div class="xph-controls">
              <button type="button" class="btn" data-wire aria-pressed="false" disabled>WIREFRAME</button>
              <button type="button" class="btn" data-ps2 aria-pressed="true" disabled>PS2 FILTER</button>
              <p data-status class="xph-status" aria-live="polite"></p>
            </div>
          </div>

          <aside class="xph-sheet" aria-label={`${s.name} spec sheet`}>
            <h3>SPEC SHEET</h3>
            <dl>
              {s.specs.map(([label, value]) => (
                <div><dt>{label}</dt><dd>{value}</dd></div>
              ))}
            </dl>
            <p>{s.note}</p>
          </aside>
        </div>

        {s.render && (
          <figure class="xph-render">
            <img src={s.render} width="1600" height="900" loading="lazy" alt={`Cycles render of the ${s.name}`} />
            <figcaption><span aria-hidden="true">■</span> RENDER // CYCLES · {s.name}</figcaption>
          </figure>
        )}
      </section>
    ))}
  </div>
</Base>

<script>
  import type { Viewer, ViewerLook } from '../scripts/ps2viewer';

  // Neutral grey "studio" so the orange paint reads true, like the renders.
  const LOOK: ViewerLook = {
    background: '#1a1814', sky: 0xf2ece0, ground: 0x2a2620, key: 0xfff1dc,
    reflections: 0.8, // metal parts need something to reflect (see ps2viewer.ts)
  };

  // Every model section works on its own: its own INSERT TAPE, its own
  // viewer, its own buttons. Three.js is still downloaded only once.
  document.querySelectorAll<HTMLElement>('[data-viewer]').forEach((section) => {
    const stage = section.querySelector<HTMLElement>('[data-stage]')!;
    const insert = section.querySelector<HTMLButtonElement>('[data-insert]')!;
    const wireBtn = section.querySelector<HTMLButtonElement>('[data-wire]')!;
    const ps2Btn = section.querySelector<HTMLButtonElement>('[data-ps2]')!;
    const status = section.querySelector<HTMLElement>('[data-status]')!;
    const file = section.dataset.file || null;
    let viewer: Viewer | null = null;

    insert.addEventListener('click', async () => {
      insert.disabled = true;
      insert.textContent = 'LOADING…';
      // Dynamic import: Three.js is split into its own file and only
      // downloaded right now. That's what keeps the rest of the site light.
      const { createViewer } = await import('../scripts/ps2viewer');
      viewer = createViewer(stage, { ...LOOK, size: Number(section.dataset.frame) || 3 });
      insert.remove();
      status.textContent = 'TRACKING…';
      try {
        await viewer.load(file);
        status.textContent = '';
      } catch (err) {
        console.error(err);
        status.textContent = 'SIGNAL LOST: could not load this model.';
        await viewer.load(null);
      }
      wireBtn.disabled = false;
      ps2Btn.disabled = false;
    });

    wireBtn.addEventListener('click', () => {
      const on = wireBtn.getAttribute('aria-pressed') !== 'true';
      wireBtn.setAttribute('aria-pressed', String(on));
      viewer?.setWireframe(on);
    });
    ps2Btn.addEventListener('click', () => {
      const on = ps2Btn.getAttribute('aria-pressed') !== 'true';
      ps2Btn.setAttribute('aria-pressed', String(on));
      viewer?.setPs2(on);
    });
  });
</script>

<style>
  /* Everything here only applies to this page (Astro scopes <style> blocks). */
  .xph {
    --x-red: #d8232a; /* ONLY for the XEPHOS title */
    --x-stamp: #2347d6; /* the SOLO PROD. stamp */
    --x-accent: #b9b2a3; /* muted bone-grey for every other highlight */
    --x-cream: #ece5d6;
    --x-paper: #dcd3c1;
    --x-ink: #15130f;
    --x-steel: #3a352d;
    --x-grey: #8c867a;
    --x-display: 'Dela Gothic One', 'Silkscreen', system-ui, sans-serif;

    color: var(--x-cream);
    text-shadow: none;
  }

  /* PS2-era "dither" on the page background: a faint 2x2 checker, the same
     trick the hardware used to fake extra colours, plus a blueprint grid. */
  :global(body[data-channel='3']) {
    background:
      linear-gradient(rgba(185, 178, 163, 0.05) 1px, transparent 1px) 0 0 / 48px 48px,
      linear-gradient(90deg, rgba(185, 178, 163, 0.05) 1px, transparent 1px) 0 0 / 48px 48px,
      repeating-conic-gradient(#191713 0 25%, #14120e 0 50%) 0 0 / 4px 4px;
  }

  .xph-crumb {
    margin: 0 0 14px;
    font-family: var(--font-display); font-size: 13px; letter-spacing: 3px; color: var(--x-grey);
  }

  /* ---------- title card ---------- */
  .xph-hero {
    position: relative; overflow: hidden;
    background: var(--x-cream); color: var(--x-ink);
    /* grime: a soft dark vignette + the same dither, very faint */
    background-image:
      radial-gradient(ellipse at 70% 30%, transparent 40%, rgba(40, 30, 30, 0.22) 100%),
      repeating-conic-gradient(rgba(0, 0, 0, 0.05) 0 25%, transparent 0 50%);
    background-size: auto, 4px 4px;
  }
  .xph-hero-inner {
    padding: clamp(20px, 4vw, 44px);
    container-type: inline-size; /* lets the title size itself to this box (cqi units) */
  }
  .xph-file {
    margin: 0 0 10px;
    font-family: var(--font-display); font-size: 12px; letter-spacing: 3px; color: var(--x-steel);
  }
  .xph-title { margin: 0; font-family: var(--x-display); font-weight: 400; line-height: 0.86; }
  .xph-title-main {
    display: block; color: var(--x-red);
    /* "XEPHOS" is ~5.4x as wide as the font size, so 17cqi always fits the box */
    font-size: clamp(36px, 17cqi, 184px); letter-spacing: -0.01em;
    /* dark offset = cheap print slightly out of register */
    text-shadow: 4px 4px 0 rgba(21, 19, 15, 0.9);
  }
  .xph-title-sub {
    display: block; margin-top: 10px; color: var(--x-ink);
    font-size: clamp(18px, 7cqi, 52px); letter-spacing: 0.04em;
  }
  .xph-summary { margin: 22px 0 0; max-width: 58ch; font-size: 24px; line-height: 1.15; }

  .xph-meta {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 12px 24px;
    margin: 24px 0 0; padding-top: 16px; border-top: 2px solid var(--x-ink);
  }
  .xph-meta dt { font-family: var(--font-display); font-size: 11px; letter-spacing: 2px; color: var(--x-grey); }
  .xph-meta dd { margin: 2px 0 0; font-size: 22px; }

  .xph-hero-foot {
    display: flex; align-items: center; gap: 14px; margin-top: 24px;
    font-family: var(--font-display); font-size: 11px; letter-spacing: 2px; color: var(--x-steel);
  }
  .xph-barcode {
    width: 120px; height: 30px; flex: none;
    background: repeating-linear-gradient(90deg,
      var(--x-ink) 0 2px, transparent 2px 4px, var(--x-ink) 4px 5px, transparent 5px 8px,
      var(--x-ink) 8px 11px, transparent 11px 12px);
  }
  .xph-stamp {
    position: absolute; right: clamp(20px, 5vw, 60px); bottom: 26px;
    display: grid; place-items: center; width: 92px; height: 92px; border-radius: 50%;
    border: 3px solid var(--x-stamp); color: var(--x-stamp);
    font-family: var(--font-display); font-size: 13px; letter-spacing: 1px; text-align: center; line-height: 1.3;
    transform: rotate(-14deg); opacity: 0.85;
  }

  /* ---------- section headers ---------- */
  .xph-spec { margin-top: clamp(40px, 6vw, 72px); }
  .xph-spec-head {
    display: flex; align-items: flex-end; gap: 16px;
    padding-bottom: 12px; margin-bottom: 18px;
    border-bottom: 3px solid var(--x-steel);
    /* ruler ticks under the line */
    background: repeating-linear-gradient(90deg, var(--x-steel) 0 1px, transparent 1px 16px) bottom / 100% 8px no-repeat;
  }
  .xph-num {
    font-family: var(--x-display); font-size: clamp(44px, 9vw, 104px); line-height: 0.8;
    color: transparent; -webkit-text-stroke: 2px var(--x-grey);
  }
  .xph-spec-head h2 {
    margin: 0; font-family: var(--x-display); font-weight: 400;
    font-size: clamp(24px, 6.4vw, 56px); color: var(--x-cream); letter-spacing: 0.02em;
  }
  .xph-role { margin: 4px 0 0; color: var(--x-grey); font-size: 22px; }

  /* ---------- the big-screen TV ---------- */
  .xph-tv {
    position: relative; max-width: 1080px; margin: 0 auto;
    padding: clamp(12px, 2.6vw, 30px) clamp(12px, 2.6vw, 30px) 0;
    border-radius: clamp(14px, 2.4vw, 30px);
    background: linear-gradient(180deg, #2e2b27, #1c1a17 70%, #151310);
    box-shadow:
      inset 0 2px 0 rgba(255, 255, 255, 0.08), inset 0 -3px 0 rgba(0, 0, 0, 0.5),
      0 0 0 2px #0b0a08, 0 30px 70px rgba(0, 0, 0, 0.65);
  }
  .xph-tv-screen {
    position: relative; aspect-ratio: 16 / 9; overflow: hidden; background: #000;
    border-radius: clamp(8px, 1.6vw, 20px) / clamp(10px, 2vw, 26px); /* slightly bulged CRT corners */
    box-shadow: 0 0 0 clamp(4px, 0.8vw, 8px) #0c0b09, 0 0 0 clamp(6px, 1vw, 10px) rgba(255, 255, 255, 0.05);
  }
  .xph-tv-screen iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .xph-tv-glass {
    position: absolute; inset: 0; z-index: 1; pointer-events: none; border-radius: inherit;
    background:
      linear-gradient(122deg, rgba(255, 255, 255, 0.07) 0 22%, transparent 34%),
      repeating-linear-gradient(0deg, rgba(0, 0, 0, 0.13) 0 1px, transparent 1px 3px);
    box-shadow: inset 0 0 clamp(30px, 6vw, 80px) rgba(0, 0, 0, 0.75);
  }
  .xph-tv-panel {
    display: flex; align-items: center; gap: clamp(10px, 2vw, 24px);
    height: clamp(44px, 6vw, 68px); padding: 0 4px;
  }
  .xph-tv-brand {
    font-family: var(--x-display); font-size: clamp(12px, 1.6vw, 18px); letter-spacing: 0.08em; color: var(--x-cream);
  }
  .xph-tv-brand b { color: var(--x-grey); font-weight: 400; }
  .xph-tv-grille {
    flex: 1; height: 45%; min-width: 40px;
    background: repeating-linear-gradient(90deg, #0d0c0a 0 3px, #2a2723 3px 6px);
    border-radius: 3px;
  }
  .xph-tv-knobs { display: flex; align-items: center; gap: 10px; }
  .xph-tv-knobs i {
    width: clamp(16px, 2vw, 24px); aspect-ratio: 1; border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, #57524a, #1b1916 70%);
    box-shadow: 0 2px 3px rgba(0, 0, 0, 0.6);
  }
  /* power LED */
  .xph-tv-knobs em {
    width: 8px; height: 8px; border-radius: 50%;
    background: #d9cfb6; box-shadow: 0 0 8px 2px rgba(217, 207, 182, 0.45);
  }
  .xph-tv-feet { display: flex; justify-content: space-between; max-width: 1080px; margin: 0 auto; padding: 0 14%; }
  .xph-tv-feet i { width: clamp(50px, 9vw, 110px); height: 12px; background: #0f0e0c; border-radius: 0 0 6px 6px; }

  /* ---------- model sections ---------- */
  .xph-spec-body {
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(240px, 320px); gap: 20px;
    align-items: start;
  }

  /* the 3D stage: square-cut steel housing with viewfinder corners */
  .xph-stage {
    border: 2px solid var(--x-steel); border-radius: 0; background: #1a1814;
    box-shadow: inset 0 0 60px rgba(0, 0, 0, 0.7), 6px 6px 0 rgba(0, 0, 0, 0.45);
  }
  .xph-frame {
    position: absolute; inset: 12px; z-index: 2; pointer-events: none;
    --c: var(--x-accent);
    background:
      linear-gradient(var(--c), var(--c)) top left / 26px 3px no-repeat,
      linear-gradient(var(--c), var(--c)) top left / 3px 26px no-repeat,
      linear-gradient(var(--c), var(--c)) top right / 26px 3px no-repeat,
      linear-gradient(var(--c), var(--c)) top right / 3px 26px no-repeat,
      linear-gradient(var(--c), var(--c)) bottom left / 26px 3px no-repeat,
      linear-gradient(var(--c), var(--c)) bottom left / 3px 26px no-repeat,
      linear-gradient(var(--c), var(--c)) bottom right / 26px 3px no-repeat,
      linear-gradient(var(--c), var(--c)) bottom right / 3px 26px no-repeat;
  }
  .xph-stage .rec { left: 28px; top: 20px; color: var(--x-cream); }
  .xph-stage .rec b { color: var(--x-accent); font-weight: 400; }
  .xph-stage .hint { right: 28px; bottom: 18px; color: var(--x-grey); }

  .xph .btn {
    border-radius: 0; border: 2px solid var(--x-steel); background: var(--x-ink); color: var(--x-cream);
    font-family: var(--font-display); font-size: 13px; letter-spacing: 1px;
  }
  .xph .btn:hover:not(:disabled) { border-color: var(--x-accent); color: var(--x-cream); }
  .xph .btn[aria-pressed='true'] { background: var(--x-cream); border-color: var(--x-cream); color: var(--x-ink); }
  .xph .btn:disabled { opacity: 0.45; cursor: default; }
  .xph-stage .insert { background: var(--x-cream); border-color: var(--x-cream); color: var(--x-ink); }
  .xph-stage .insert:hover:not(:disabled) { background: var(--x-accent); border-color: var(--x-accent); }

  .xph-controls { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin-top: 12px; }
  .xph-status { margin: 0 0 0 6px; color: var(--x-cream); min-height: 1.2em; }

  /* spec sheet: a cream data card */
  .xph-sheet { background: var(--x-paper); color: var(--x-ink); padding: 0 0 16px; box-shadow: 6px 6px 0 rgba(0, 0, 0, 0.45); }
  .xph-sheet h3 {
    margin: 0 0 6px; padding: 8px 14px; background: var(--x-ink); color: var(--x-cream);
    font-size: 13px; letter-spacing: 3px; border-left: 8px solid var(--x-steel);
  }
  .xph-sheet dl { margin: 0; padding: 0 14px; }
  .xph-sheet dl div {
    display: flex; justify-content: space-between; gap: 12px; padding: 7px 0;
    border-bottom: 1px dashed rgba(21, 19, 15, 0.35);
  }
  .xph-sheet dt { font-family: var(--font-display); font-size: 11px; letter-spacing: 1px; color: var(--x-steel); padding-top: 4px; }
  .xph-sheet dd { margin: 0; font-size: 21px; text-align: right; }
  .xph-sheet p { margin: 12px 14px 0; font-size: 21px; line-height: 1.15; }

  .xph-render { margin: 24px 0 0; }
  .xph-render img {
    display: block; width: 100%; height: auto;
    border: 2px solid var(--x-steel); box-shadow: 6px 6px 0 rgba(0, 0, 0, 0.45);
  }
  .xph-render figcaption {
    margin-top: 10px; font-family: var(--font-display); font-size: 11px; letter-spacing: 2px; color: var(--x-grey);
  }
  .xph-render figcaption span { color: var(--x-accent); }

  /* ---------- narrow screens: stack everything ---------- */
  @media (max-width: 900px) {
    .xph-spec-body { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 560px) {
    .xph-stamp { display: none; }
    .xph-stage .hint { display: none; }
    .xph-tv-grille { display: none; }
  }
</style>
