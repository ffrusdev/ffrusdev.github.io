---
// The shell every page sits in: <head>, top bar, channel bar, CRT overlay.
// `home` pages draw the physical TV instead of the full-screen CRT overlay.
import '../styles/global.css';
import ChannelBar from '../components/ChannelBar.astro';
import SoundToggle from '../components/SoundToggle.astro';
import { channels, chLabel } from '../data/channels';

interface Props {
  title: string;
  channel: number;
  description?: string;
  home?: boolean;
}

const {
  title,
  channel,
  description = 'Nabil Luqman (frus): game designer and Unity developer from Malaysia.',
  home = false,
} = Astro.props;
const channelName = channels.find((c) => c.num === channel)?.label ?? '';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · FRUS</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={`${title} · FRUS`} />
    <meta property="og:description" content={description} />
    <meta name="theme-color" content="#0b0c0a" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Silkscreen:wght@400;700&family=VT323&display=swap"
      rel="stylesheet"
    />
    <!-- Arrived here by changing channel? Mark it before the first paint so the
         page starts under static instead of flashing up plain (see channels.ts). -->
    <script is:inline>
      try {
        if (sessionStorage.getItem('frus-tuning')) {
          sessionStorage.removeItem('frus-tuning');
          if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('tuning');
        }
      } catch (e) {}
    </script>
    <!-- A page can add extra <head> tags (like its own fonts) with slot="head". -->
    <slot name="head" />
  </head>
  <body data-channel={channel}>
    <a class="skip" href="#content">Skip to content</a>

    <header class="topbar">
      <a href="/" class="logo" data-channel-link>FRUS<span> · NABIL LUQMAN</span></a>
      <div class="topbar-right">
        <span aria-hidden="true">LOC: MY · UTC+8</span>
        <SoundToggle />
      </div>
    </header>

    {!home && <ChannelBar current={channel} />}

    <main id="content">
      <slot />
    </main>

    {!home && <div class="crt-overlay" aria-hidden="true" />}
    <!-- channel change: a soft blink of live static, and the TV's
         on-screen channel number (filled in by channels.ts when leaving) -->
    <div class="static-burst" aria-hidden="true">
      <canvas class="static-noise"></canvas>
    </div>
    <p class="ch-osd" aria-hidden="true"><b>{chLabel(channel)}</b><span>{channelName}</span></p>

    <script>
      import '../scripts/sound';
      import '../scripts/channels';
    </script>
  </body>
</html>
