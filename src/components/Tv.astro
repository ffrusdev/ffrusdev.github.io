---
// The physical TV on the homepage. Whatever you put between <Tv>...</Tv>
// is drawn on the screen (that's what <slot /> does).
import { channels, chLabel } from '../data/channels';
---

<div class="tv-wrap">
  <div class="tv">
    <div class="tv-screen">
      <div class="noise" aria-hidden="true"></div>
      <!-- Everything in .tv-warp gets bent by the fish-eye filter below.
           (The moving noise/roll layers stay outside: re-bending them every
           frame would cost performance, and you can't see bends in noise.) -->
      <div class="tv-warp" data-crt-warp="crt-barrel" data-crt-strength="0.07">
        <div class="tv-content">
          <slot />
        </div>
        <div class="scan" aria-hidden="true"></div>
        <div class="osd" aria-hidden="true">CH 00</div>
      </div>
      <div class="roll" aria-hidden="true"></div>
    </div>

    <!-- The fish-eye filter. src/scripts/crt-warp.ts fills in the map image
         and sizes, then turns it on. -->
    <svg class="sr-defs" width="0" height="0" aria-hidden="true" focusable="false">
      <filter id="crt-barrel" color-interpolation-filters="sRGB" filterUnits="userSpaceOnUse" primitiveUnits="userSpaceOnUse">
        <feImage result="map" preserveAspectRatio="none" />
        <feDisplacementMap in="SourceGraphic" in2="map" scale="0" xChannelSelector="R" yChannelSelector="G" />
      </filter>
    </svg>

    <div class="tv-controls">
      <nav class="tv-channels" aria-label="Channels">
        {
          channels.map((c) => (
            <a
              class="ch-btn"
              href={c.href}
              data-channel-link
              aria-current={c.num === 0 ? 'page' : undefined}
            >
              {chLabel(c.num)} {c.label}
            </a>
          ))
        }
      </nav>
      <div class="knobs" aria-hidden="true">
        <span class="knob"></span>
        <span class="knob k2"></span>
      </div>
    </div>
  </div>
  <p class="sticky-note">hi! pick a channel :)</p>
  <div class="tv-stand" aria-hidden="true"></div>
</div>

<script>
  import '../scripts/crt-warp';
</script>
