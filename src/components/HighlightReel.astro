---
import PoweredByStrip from './PoweredByStrip.astro';
// "Highlight reel" for the homepage: scroll down and a big VHS cassette
// slides up from in front of the monitor into the VCR's slot, the monitor
// powers on, and it plays a TV-commercial style reel of your work (stills,
// key art, logos). Scroll back up to eject.
//
// How it works:
//  - The section is tall (230vh) and its contents stick to the screen, so
//    scrolling through it "scrubs" the insert animation (--e = tape rises
//    into view, --t = tape slides up into the slot, both 0 → 1, set by the
//    script below). The tape sits in a box whose top edge is the slot line,
//    with overflow hidden, so it disappears exactly at the slot.
//  - Once the tape is in, the screen turns on and the ads play on a timer.
// Edit the ads in `ads` below. Each one links to its page.
interface Ad {
  img: string;
  pos?: string; // which part of the image to keep when cropping (CSS object-position)
  logo?: string; // optional logo shown instead of the title text
  kicker: string;
  title: string;
  tag: string;
  cta: string;
  href: string;
}
const ads: Ad[] = [
  {
    img: '/projects/we-are-cooked/key-art.webp',
    logo: '/projects/we-are-cooked/logo.webp',
    kicker: 'IN DEVELOPMENT · CH01',
    title: 'WE ARE COOKED!',
    tag: '2 vs 2 kitchen chaos. Free demo out now.',
    cta: 'PLAY THE DEMO ▶',
    href: '/projects/we-are-cooked/',
  },
  {
    img: '/xephos/still-through-the-belt.webp',
    kicker: 'NOW SHOWING · CH03',
    title: 'XEPHOS: STARBOUND',
    tag: 'A retro-future short film, made solo.',
    cta: 'WATCH ON CH03 ▶',
    href: '/models/xephos/',
  },
  {
    img: '/hammer-of-gods/forge-brothers.webp',
    kicker: 'NOW SHOWING · CH03',
    title: 'HAMMER OF GODS',
    tag: 'Two brothers. One hammer. One knock at the door.',
    cta: 'WATCH ON CH03 ▶',
    href: '/models/hammer-of-gods/',
  },
  {
    img: '/projects/a-way-end/poster.webp',
    pos: '50% 35%',
    kicker: 'ON THE SHELF · CH01',
    title: 'A WAY END',
    tag: 'Find the sword. Survive the dungeon.',
    cta: 'SEE IT ON CH01 ▶',
    href: '/projects/a-way-end/',
  },
  {
    img: '/xephos/mantis-07-render.webp',
    kicker: 'NEW IN 3D · CH03',
    title: 'MANTIS-07',
    tag: 'Spin the starfighter in your browser. PS2 filter included.',
    cta: 'INSERT TAPE ▶',
    href: '/models/xephos/',
  },
];
---

<section class="reel" data-reel aria-label="Highlight reel">
  <div class="reel-sticky">
    <p class="reel-hint" aria-hidden="true">▼ SCROLL TO INSERT TAPE ▼</p>

    <div class="reel-set">
      <!-- the VCR on top, as wide as the monitor, with a long cassette slot -->
      <div class="reel-vcr" aria-hidden="true">
        <span class="reel-slot"></span>
        <span class="reel-vcr-left">
          <span class="reel-brand">FRUS VCR-88 · HQ</span>
          <span class="reel-btns"><i></i><i></i><i></i><i></i></span>
        </span>
        <span class="reel-led" data-led>-- : --</span>
      </div>

      <!-- the second screen, underneath -->
      <div class="reel-monitor">
        <div class="reel-screen" data-screen>
          <div class="reel-ads" aria-live="off">
            {ads.map((ad, i) => (
              <a class="reel-ad" href={ad.href} data-ad={i} tabindex="-1">
                <img src={ad.img} alt="" loading="lazy" style={ad.pos ? `object-position: ${ad.pos}` : undefined} />
                <span class="reel-copy">
                  <span class="reel-kicker">{ad.kicker}</span>
                  {ad.logo
                    ? <img class="reel-logo" src={ad.logo} alt={ad.title} loading="lazy" />
                    : <span class="reel-title">{ad.title}</span>}
                  <span class="reel-tag">{ad.tag}</span>
                  <span class="reel-cta">{ad.cta}</span>
                </span>
              </a>
            ))}
          </div>
          <span class="reel-osd reel-osd--play" aria-hidden="true">PLAY ▶</span>
          <span class="reel-osd reel-osd--sp" aria-hidden="true">SP <b data-counter>0:00:00</b></span>
          <!-- CRT tube look, layered over the picture (all click-through) -->
          <span class="reel-scan" aria-hidden="true"></span>
          <span class="reel-noise" aria-hidden="true"></span>
          <span class="reel-roll" aria-hidden="true"></span>
          <span class="reel-band" aria-hidden="true"></span>
          <span class="reel-glass" aria-hidden="true"></span>
          <!-- one button per ad: jump straight to it -->
          <div class="reel-pips">
            {ads.map((ad, i) => (
              <button type="button" class="reel-pip" data-pip={i} aria-label={`Show ad ${i + 1} of ${ads.length}: ${ad.title}`}><i></i></button>
            ))}
          </div>
          <span class="reel-flash" aria-hidden="true"></span>
        </div>

        <div class="reel-chin" aria-hidden="true">
          <span>FRUS · HI-FI STEREO</span>
          <i class="reel-power"></i>
        </div>
      </div>

      <!-- sponsor line under the screen: tool logos scrolling left -->
      <PoweredByStrip />

      <!-- the cassette: starts in front of the (dark) monitor and slides up
           into the slot. This box starts at the slot line and clips the tape. -->
      <div class="reel-insert" aria-hidden="true">
        <div class="reel-tape">
          <span class="reel-label"><b>FRUS</b> HIGHLIGHT REEL <em>T-120</em></span>
          <span class="reel-window"><i></i><i></i></span>
        </div>
      </div>

    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-reel]').forEach((reel) => {
    const screen = reel.querySelector<HTMLElement>('[data-screen]')!;
    const ads = [...reel.querySelectorAll<HTMLAnchorElement>('[data-ad]')];
    const pips = [...reel.querySelectorAll<HTMLButtonElement>('[data-pip]')];
    const counter = reel.querySelector<HTMLElement>('[data-counter]')!;
    const led = reel.querySelector<HTMLElement>('[data-led]')!;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const AD_MS = 3800; // how long each ad stays on screen
    const clamp = (v: number) => Math.min(1, Math.max(0, v));

    let loaded = false;
    let current = -1;
    let timer = 0;
    let clock = 0;
    let started = 0;
    let paused = false;

    function show(i: number) {
      current = (i + ads.length) % ads.length;
      ads.forEach((a, n) => {
        const on = n === current;
        a.classList.toggle('is-active', on);
        a.tabIndex = on ? 0 : -1; // only the ad on screen can be tabbed to
      });
      pips.forEach((p, n) => {
        p.classList.toggle('is-active', n === current);
        p.setAttribute('aria-current', n === current ? 'true' : 'false');
      });
    }
    // Switch ads with a quick VHS glitch, like cutting between commercials.
    function cutTo(i: number) {
      if (reduceMotion) return show(i);
      screen.classList.add('is-glitch');
      window.setTimeout(() => show(i), 140);
      window.setTimeout(() => screen.classList.remove('is-glitch'), 360);
    }
    function next() {
      if (paused) return;
      cutTo(current + 1);
    }
    // Clicking a pip jumps to that ad and restarts its timer.
    pips.forEach((pip, i) =>
      pip.addEventListener('click', () => {
        if (!loaded || i === current) return;
        cutTo(i);
        window.clearInterval(timer);
        timer = window.setInterval(next, AD_MS);
      }),
    );
    function tick() {
      const s = Math.floor((Date.now() - started) / 1000);
      counter.textContent = `0:${String(Math.floor(s / 60)).padStart(2, '0')}:${String(s % 60).padStart(2, '0')}`;
    }

    function load() {
      loaded = true;
      reel.classList.add('is-on');
      led.textContent = 'PLAY ▶';
      started = Date.now();
      show(0);
      timer = window.setInterval(next, AD_MS);
      clock = window.setInterval(tick, 1000);
      tick();
    }
    function eject() {
      loaded = false;
      reel.classList.remove('is-on');
      led.textContent = '-- : --';
      window.clearInterval(timer);
      window.clearInterval(clock);
      ads.forEach((a) => a.classList.remove('is-active'));
    }

    // Scroll position inside the section → insert animation.
    //   0.00–0.15  tape flies in      (--e)
    //   0.15–0.45  tape sinks in      (--t)
    //   0.45+      loaded: screen on, ads play
    let queued = false;
    function update() {
      queued = false;
      const r = reel.getBoundingClientRect();
      const travel = reel.offsetHeight - window.innerHeight;
      const p = travel > 0 ? clamp(-r.top / travel) : 1;
      reel.style.setProperty('--e', String(clamp(p / 0.15)));
      reel.style.setProperty('--t', String(clamp((p - 0.15) / 0.3)));
      const shouldPlay = p >= 0.45;
      if (shouldPlay !== loaded) (shouldPlay ? load : eject)();
    }
    const onScroll = () => {
      if (!queued) {
        queued = true;
        requestAnimationFrame(update);
      }
    };

    if (reduceMotion) {
      // No scroll animation: the tape is already in and the reel just plays.
      reel.classList.add('reel--static');
      reel.style.setProperty('--e', '1');
      reel.style.setProperty('--t', '1');
      load();
    } else {
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll);
      update();
    }

    // Hovering (or focusing) the screen pauses the reel so the ad can be read.
    screen.addEventListener('mouseenter', () => (paused = true));
    screen.addEventListener('mouseleave', () => (paused = false));
    screen.addEventListener('focusin', () => (paused = true));
    screen.addEventListener('focusout', () => (paused = false));
  });
</script>

<style>
  /* margin-top pulls it up over the homepage's bottom padding, so there's less empty space above */
  .reel { position: relative; height: 230vh; margin-top: -44px; --e: 0; --t: 0; }
  .reel--static { height: auto; }
  .reel-sticky {
    position: sticky; top: 0; height: 100vh; overflow: hidden; overflow: clip;
    display: flex; flex-direction: column; align-items: center; justify-content: flex-start; gap: 10px;
    padding: clamp(10px, 3vh, 26px) 16px 16px;
  }
  .reel--static .reel-sticky { position: static; height: auto; padding: 40px 16px; }
  .reel-hint {
    margin: 0; font-family: var(--font-display); font-size: 12px; letter-spacing: 3px; color: var(--phosphor-dim);
    opacity: calc(1 - var(--e)); animation: blink 1.1s steps(1) infinite;
  }
  .reel.is-on .reel-hint { visibility: hidden; }

  .reel-set {
    /* VCR + monitor share this width: as wide as fits the screen height */
    --w: min(820px, 100%, calc((100vh - 380px) * 16 / 9)); /* 380px = VCR + strip + gaps + frame */
    --tw: calc(var(--w) * 0.5); /* cassette width: half the monitor, so it reads BIG */
    --slot-y: 34px; /* slot line, from the top of the VCR */
    position: relative; display: flex; flex-direction: column; align-items: stretch; gap: 10px;
    width: var(--w);
  }

  /* ---------- the monitor ---------- */
  .reel-monitor {
    width: 100%; padding: clamp(10px, 1.6vw, 18px) clamp(10px, 1.6vw, 18px) 0;
    border-radius: 18px; background: linear-gradient(180deg, var(--plastic), var(--plastic-dark));
    box-shadow: inset 0 2px 0 rgba(255, 255, 255, 0.07), 0 0 0 2px #0b0a08, 0 30px 60px rgba(0, 0, 0, 0.6);
  }
  .reel-screen {
    position: relative; aspect-ratio: 16 / 9; background: #050605;
    /* clip, not hidden: a "hidden" box can still be scrolled by the browser
       (e.g. when a pip button gets focus), which shifted the whole picture */
    overflow: hidden; overflow: clip;
    border-radius: 26px / 22px; /* bulged tube corners */
    box-shadow: 0 0 0 6px #0c0b09, 0 0 0 8px rgba(255, 255, 255, 0.05);
  }
  .reel-chin {
    display: flex; align-items: center; justify-content: space-between; height: 40px; padding: 0 6px;
    font-family: var(--font-display); font-size: 10px; letter-spacing: 2px; color: var(--muted);
  }
  .reel-power { width: 8px; height: 8px; border-radius: 50%; background: #3a1d17; }
  .reel.is-on .reel-power { background: #ff5a3a; box-shadow: 0 0 8px 2px rgba(255, 90, 58, 0.6); }

  /* the ads: stacked, only the active one is visible */
  .reel-ads { position: absolute; inset: 0; opacity: 0; transition: opacity 0.2s 0.35s; }
  .reel.is-on .reel-ads { opacity: 1; }
  .reel-ad {
    position: absolute; inset: 0; display: block; opacity: 0; color: #fff; text-decoration: none; text-shadow: none;
  }
  .reel-ad.is-active { opacity: 1; }
  .reel-ad > img {
    position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover;
    /* CRT picture: punchy colour, a touch of softness and bloom */
    filter: saturate(1.12) contrast(1.14) brightness(1.04) blur(0.35px);
  }
  /* slow push-in on the active ad, like a commercial */
  .reel-ad.is-active > img { animation: reel-push 4.2s linear both; }
  @keyframes reel-push { from { transform: scale(1.1); } to { transform: scale(1); } }

  .reel-copy {
    position: absolute; left: 0; right: 0; bottom: 0; z-index: 1;
    display: flex; flex-direction: column; align-items: flex-start; gap: clamp(4px, 0.8vw, 8px);
    padding: clamp(14px, 3vw, 34px) clamp(14px, 3vw, 34px) clamp(16px, 3vw, 36px);
    background: linear-gradient(transparent, rgba(0, 0, 0, 0.82) 55%);
  }
  .reel-kicker {
    padding: 3px 8px; background: var(--note); color: #14130f;
    font-family: var(--font-display); font-size: clamp(9px, 1.1vw, 12px); letter-spacing: 2px;
  }
  .reel-title {
    font-family: var(--font-display); font-weight: 700; font-size: clamp(20px, 4.4vw, 50px); line-height: 1;
    /* slight red/blue colour bleed, like a worn tape */
    text-shadow: -2px 0 0 rgba(255, 40, 60, 0.6), 2px 0 0 rgba(40, 140, 255, 0.6), 4px 4px 0 #000;
  }
  .reel-logo { width: clamp(150px, 38%, 360px); height: auto; filter: drop-shadow(3px 3px 0 rgba(0, 0, 0, 0.7)); }
  .reel-tag { font-size: clamp(16px, 2.2vw, 26px); line-height: 1.1; color: #f1ede2; text-shadow: 0 0 6px rgba(255, 255, 255, 0.35), 2px 2px 0 #000; }
  .reel-cta {
    margin-top: 4px; padding: 5px 10px; border: 2px solid var(--phosphor); color: var(--phosphor);
    font-family: var(--font-display); font-size: clamp(10px, 1.2vw, 13px); letter-spacing: 2px;
    background: rgba(0, 0, 0, 0.45);
  }
  .reel-ad:hover .reel-cta, .reel-ad:focus-visible .reel-cta { background: var(--phosphor); color: #0b0c0a; }

  /* VCR on-screen display */
  .reel-osd {
    position: absolute; z-index: 2; top: clamp(8px, 2vw, 18px); opacity: 0;
    font-size: clamp(18px, 2.6vw, 30px); color: #fff; letter-spacing: 1px;
    text-shadow: 2px 2px 0 rgba(0, 0, 0, 0.8), 0 0 6px rgba(255, 255, 255, 0.5);
  }
  .reel-osd--play { left: clamp(10px, 2.4vw, 22px); }
  .reel-osd--sp { right: clamp(10px, 2.4vw, 22px); }
  .reel-osd b { font-weight: 400; margin-left: 8px; }
  .reel.is-on .reel-osd { opacity: 1; transition: opacity 0s 0.5s; }
  /* blink only once the tape plays (the blink animation would otherwise un-hide it) */
  .reel.is-on .reel-osd--play { animation: blink 1.1s steps(1) 0.5s infinite; }
  /* pips: one small bar per ad, each a button (big invisible hit area around the bar) */
  .reel-pips {
    position: absolute; z-index: 6; right: clamp(6px, 2vw, 16px); bottom: clamp(4px, 1.4vw, 12px);
    display: flex; visibility: hidden; opacity: 0;
  }
  .reel.is-on .reel-pips { visibility: visible; opacity: 1; transition: opacity 0s 0.5s; }
  .reel-pip { display: grid; place-items: center; padding: 8px 4px; border: 0; background: none; cursor: pointer; }
  .reel-pip i { display: block; width: 16px; height: 5px; background: rgba(255, 255, 255, 0.35); box-shadow: 0 1px 0 rgba(0, 0, 0, 0.6); }
  .reel-pip:hover i { background: rgba(255, 255, 255, 0.75); }
  .reel-pip.is-active i { background: var(--note); }
  .reel-pip:focus-visible { outline: 2px solid var(--phosphor); outline-offset: -2px; }

  /* tape wear: a faint tracking band rolling down + scanlines + glass */
  .reel-band {
    position: absolute; z-index: 3; left: 0; right: 0; top: -12%; height: 8%; pointer-events: none; opacity: 0;
    background: repeating-linear-gradient(90deg, rgba(255, 255, 255, 0.18) 0 3px, transparent 3px 7px, rgba(255, 255, 255, 0.08) 7px 9px);
    filter: blur(0.5px);
  }
  .reel.is-on .reel-band { opacity: 1; animation: reel-band 7s linear infinite; }
  @keyframes reel-band { 0%, 60% { top: -12%; } 100% { top: 110%; } }
  /* ---- CRT tube filter (same recipe as the homepage TV) ---- */
  /* scanlines + a faint red/green/blue phosphor grid */
  .reel-scan {
    position: absolute; inset: 0; z-index: 3; pointer-events: none;
    background:
      repeating-linear-gradient(0deg, rgba(0, 0, 0, 0.34) 0 1px, transparent 1px 3px),
      repeating-linear-gradient(90deg, rgba(255, 60, 60, 0.05) 0 1px, rgba(60, 255, 120, 0.05) 1px 2px, rgba(60, 120, 255, 0.05) 2px 3px);
  }
  /* moving grain */
  .reel-noise {
    position: absolute; inset: -20%; z-index: 3; pointer-events: none; opacity: 0;
    background-image: radial-gradient(rgba(255, 255, 255, 0.08) 1px, transparent 1px), radial-gradient(rgba(255, 255, 255, 0.06) 1px, transparent 1px);
    background-size: 3px 3px, 5px 5px; background-position: 0 0, 1px 2px;
  }
  .reel.is-on .reel-noise { opacity: 1; animation: noise 0.25s steps(2) infinite; }
  /* slow bright bar rolling down the tube */
  .reel-roll { position: absolute; z-index: 3; left: 0; right: 0; top: -20%; height: 18%; pointer-events: none; background: rgba(255, 255, 255, 0.045); }
  .reel.is-on .reel-roll { animation: roll 6s linear infinite; }
  /* curved glass: reflection, hotspot, edges falling off into darkness */
  .reel-glass {
    position: absolute; inset: 0; z-index: 4; pointer-events: none; border-radius: inherit;
    background:
      linear-gradient(122deg, rgba(255, 255, 255, 0.06) 0 34%, rgba(255, 255, 255, 0) 34.4%),
      radial-gradient(ellipse 55% 40% at 26% 16%, rgba(255, 255, 255, 0.08), transparent 70%),
      radial-gradient(ellipse 78% 78% at 50% 50%, transparent 55%, rgba(0, 0, 0, 0.7) 100%);
    box-shadow: inset 0 0 70px rgba(0, 0, 0, 0.8);
  }
  .reel.is-on .reel-screen { animation: flicker 4s infinite; }
  /* switching ads: the picture jumps sideways and the band flashes through */
  .reel-screen.is-glitch .reel-ads { transform: translateX(-2%) skewX(-3deg); filter: hue-rotate(40deg) brightness(1.4) contrast(1.4); }
  .reel-screen.is-glitch .reel-band { top: 40%; height: 22%; opacity: 1; animation: none; }

  /* CRT power-on: a white line that opens up into the picture */
  .reel-flash { position: absolute; inset: 0; z-index: 5; background: #f4fff0; pointer-events: none; opacity: 0; transform: scale(0, 0.004); }
  .reel.is-on .reel-flash { animation: reel-on 0.55s ease-out both; }
  @keyframes reel-on {
    0% { opacity: 1; transform: scale(0, 0.004); }
    35% { opacity: 1; transform: scale(1, 0.004); }
    70% { opacity: 0.9; transform: scale(1, 1); }
    100% { opacity: 0; transform: scale(1, 1); }
  }

  /* ---------- the VCR (on top) ---------- */
  .reel-vcr {
    position: relative; z-index: 1; height: 118px; padding: 0 clamp(12px, 2vw, 20px) 14px;
    display: flex; align-items: flex-end; justify-content: space-between; gap: 12px;
    border-radius: 8px 8px 10px 10px;
    background: linear-gradient(180deg, #3a3631 0 10px, #2b2823 10px, #1d1b17);
    box-shadow: inset 0 2px 0 rgba(255, 255, 255, 0.08), 0 0 0 2px #0b0a08, 0 18px 30px rgba(0, 0, 0, 0.6);
  }
  /* the long cassette slot across the front, with a hinged flap */
  .reel-slot {
    position: absolute; left: 50%; top: calc(var(--slot-y) - 8px); height: 16px;
    width: calc(var(--tw) + 28px); transform: translateX(-50%);
    border-radius: 3px; background: #070706;
    box-shadow: inset 0 3px 4px rgba(0, 0, 0, 0.95), 0 1px 0 rgba(255, 255, 255, 0.08);
  }
  .reel-slot::after { /* the flap: lifts while the tape goes in */
    content: ''; position: absolute; left: 3px; right: 3px; top: 2px; height: 10px;
    background: linear-gradient(180deg, #34312c, #24221e); transform-origin: top;
    transform: scaleY(max(0, 1 - var(--t) * 4)); /* folds up out of the way as the tape reaches it */
  }
  .reel.is-on .reel-slot::after { transform: scaleY(1); } /* closes behind the tape */
  .reel-vcr-left { display: flex; flex-direction: column; gap: 10px; }
  .reel-brand { font-family: var(--font-display); font-size: 11px; letter-spacing: 2px; color: var(--ink); }
  .reel-led {
    padding: 6px 12px; min-width: 104px; text-align: center;
    background: #071006; color: var(--phosphor); font-size: 24px; letter-spacing: 1px;
    text-shadow: 0 0 6px rgba(184, 242, 160, 0.7); box-shadow: inset 0 0 0 2px #1a2418;
  }
  .reel-btns { display: flex; gap: 6px; }
  .reel-btns i { width: 24px; height: 10px; border-radius: 2px; background: #45413a; box-shadow: 0 2px 0 #0d0c0a; }
  .reel-btns i:first-child { background: #8e2a1f; }

  /* ---------- the cassette ---------- */
  /* Box from the slot line down over the monitor. overflow: hidden is what
     makes the tape vanish exactly at the slot as it slides up. */
  .reel-insert {
    position: absolute; z-index: 6; left: 0; right: 0; top: var(--slot-y); bottom: 0;
    overflow: hidden; overflow: clip; pointer-events: none;
  }
  .reel-tape {
    --rest: calc(118px - var(--slot-y) + 40px); /* where it waits: just below the VCR, in front of the screen */
    position: absolute; left: 50%; top: var(--rest); width: var(--tw); aspect-ratio: 1.79;
    container-type: inline-size; /* inner sizes in cqw, so the whole tape scales together */
    border-radius: 2.5cqw; background: linear-gradient(180deg, #232220, #121110);
    box-shadow: inset 0 0 0 1cqw #2f2d2a, 0 14px 28px rgba(0, 0, 0, 0.7);
    /* rises into view (--e), then slides up through the slot (--t) */
    opacity: var(--e);
