---
// "POWERED BY ..." sticker in the style of old-web 88x31 buttons.
// Meant for the corner of a ShowcaseTv:
//   <ShowcaseTv ...><EngineBadge slot="badge" mark="UE5" name="UNREAL" sub="ENGINE 5" /></ShowcaseTv>
//
// Built at the classic 88x31 size with an 8px pixel font, then scaled up 2x
// so it stays readable. It hangs off the TV's top-right corner (above the
// screen, so it never covers YouTube's own buttons) with a strip of tape.
// The mark is either short text in a circle ("UE5") or, if `logo` is set,
// a tiny pixel-art logo from public/logos/ (made with scripts/pixel-logo.mjs),
// shown with crisp square pixels.
interface Props {
  mark: string; // short text in the circle, e.g. "UE5", "U6" (fallback when there's no logo)
  logo?: string; // optional logo image path; replaces the circle
  name: string; // bold line, e.g. "UNREAL", "UNITY 6"
  sub?: string; // optional last line, e.g. "ENGINE 5"
}
const { mark, logo, name, sub } = Astro.props;
const label = ['Powered by', name, sub].filter(Boolean).join(' ');
---

<span class="eb" role="img" aria-label={label}>
  <span class="eb-face" aria-hidden="true">
    {logo
      ? <img class="eb-logo" src={logo} alt="" height="18" />
      : <span class="eb-mark">{mark}</span>}
    <span class="eb-text"><small>POWERED BY</small><b>{name}</b>{sub && <span>{sub}</span>}</span>
  </span>
</span>

<style>
  .eb {
    position: absolute; z-index: 3; top: -34px; right: -24px; width: 88px; height: 31px;
    transform: rotate(4deg) scale(2); transform-origin: top right; pointer-events: none;
  }
  .eb-face {
    position: relative; width: 100%; height: 100%;
    display: flex; align-items: center; gap: 3px; padding: 2px 2px 2px 3px;
    background: linear-gradient(180deg, #4a4741, #1b1a17 55%, #0e0d0b);
    border: 1px solid #000;
    /* light top-left + dark bottom-right edge = the chunky 3D bevel of 90s buttons */
    box-shadow: inset 1px 1px 0 rgba(255, 255, 255, 0.35), inset -1px -1px 0 rgba(0, 0, 0, 0.8), 2px 2px 0 rgba(0, 0, 0, 0.5);
    font-family: var(--font-display); font-size: 8px; line-height: 8px; color: #f2eee6;
    overflow: hidden; /* keeps the shine inside the button */
  }
  .eb-mark {
    flex: none; width: 23px; height: 23px; display: flex; align-items: center; justify-content: center;
    background: #f2eee6; color: #0e0d0b; border-radius: 50%; font-size: 7px; font-weight: 700;
    letter-spacing: -0.5px; white-space: nowrap;
    box-shadow: inset 0 0 0 2px #0e0d0b, 0 0 0 1px #f2eee6;
  }
  .eb-logo {
    flex: none; width: auto; height: 18px; margin: 0 1px 0 2px;
    image-rendering: pixelated; /* keep the pixels square when the badge is scaled up */
  }
  .eb-text { display: flex; flex-direction: column; white-space: nowrap; color: #a9a397; }
  .eb-text small { font-size: 6px; letter-spacing: 0.3px; }
  .eb-text b { color: #fff; font-weight: 700; }
  /* the shine that sweeps across every few seconds, like an animated GIF */
  .eb-face::after {
    content: ''; position: absolute; top: -10px; bottom: -10px; width: 10px; left: -20px;
    background: rgba(255, 255, 255, 0.28); transform: skewX(-20deg);
    animation: eb-shine 4s steps(12, end) infinite;
  }
  @keyframes eb-shine {
    0%, 70% { left: -20px; }
    100% { left: 100px; }
  }
  /* strip of tape holding it on */
  .eb::before {
    content: ''; position: absolute; z-index: 1; top: -3px; left: 34px; width: 22px; height: 7px;
    background: rgba(236, 229, 214, 0.55); transform: rotate(-6deg);
  }
  @media (prefers-reduced-motion: reduce) {
    .eb-face::after { animation: none; display: none; }
  }
  @media (max-width: 560px) {
    .eb { top: -38px; right: -6px; transform: rotate(4deg) scale(1.5); }
  }
</style>
